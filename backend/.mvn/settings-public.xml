<?xml version="1.0" encoding="UTF-8"?>
<!--
  Public-network Maven settings used by scripts/package-mac.sh (via -s).
  Bypasses any corporate Artifactory mirror configured in ~/.m2/settings.xml
  by routing every repository straight to Maven Central — everything this
  project needs lives there.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>maven-central-direct</id>
      <mirrorOf>*</mirrorOf>
      <name>Maven Central (direct)</name>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>
</settings>
